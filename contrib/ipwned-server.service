[Unit]
Description=ipwned password check http service
After=network.target

[Service]
ExecStart=/opt/bin/ipwned-server
User=ipwned-server
Group=ipwned-server
WorkingDirectory=~

PrivateTmp=true
NonBlocking=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=true
ProtectProc=invisible
ProcSubset=pid
NoNewPrivileges=yes
SecureBits=no-setuid-fixup-locked noroot-locked
Nice=2
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
